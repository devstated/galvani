# Force LF everywhere: shell scripts and configs with CRLF break inside Linux containers
# (especially when the repo is cloned on Windows).
* text=auto eol=lf

*.sh      text eol=lf
*.caddy   text eol=lf
Caddyfile text eol=lf
*.ini     text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
image/bin/* text eol=lf
bin/*     text eol=lf

*.png binary
*.jpg binary
