#!/bin/sh
# Galvani entrypoint.
#
# Responsibilities (all opt-in via env, all no-ops for non-app commands):
#   1. Resolve worker mode / hot reload (on|off|auto)                 (GALVANI_WORKER_MODE, GALVANI_HOT_RELOAD)
#   2. Refuse to start in prod with missing/weak/placeholder secrets  (GALVANI_REQUIRED_SECRETS)
#   3. Install vendors on first dev start                             (GALVANI_COMPOSER_INSTALL=1)
#   4. Wait for the database and run Doctrine migrations              (GALVANI_MIGRATE=1)
set -eu

log() { printf '[galvani] %s\n' "$*" >&2; }
die() { log "FATAL: $*"; exit 1; }

# `docker run image --some-flag` -> pass flags to frankenphp
if [ "${1#-}" != "$1" ]; then
	set -- frankenphp run "$@"
fi

is_app_command() {
	case "$1" in
		frankenphp | php | bin/console | galvani-worker) return 0 ;;
		*) return 1 ;;
	esac
}

# File-change events (inotify) only arrive on Linux filesystems. Host folders shared
# into a VM (Windows: 9p, macOS: virtiofs, network shares, FUSE) never deliver them,
# so file watching cannot work there. Unknown types count as "no events".
fs_type() { stat -f -c %T "$1" 2>/dev/null || echo unknown; }
fs_has_events() {
	case "$(fs_type "$1")" in
		ext2/ext3 | ext4 | btrfs | xfs | overlayfs | tmpfs | zfs | f2fs) return 0 ;;
		*) return 1 ;;
	esac
}

# Values end up in Caddyfile import paths: allow only known values.
resolve_modes() {
	is_prod=0
	[ "${APP_ENV:-prod}" = "prod" ] && is_prod=1

	GALVANI_WORKER_MODE="${GALVANI_WORKER_MODE:-on}"
	case "$GALVANI_WORKER_MODE" in
		on | off) ;;
		auto)
			if [ "$is_prod" = 1 ] || fs_has_events /app; then
				GALVANI_WORKER_MODE=on
			else
				GALVANI_WORKER_MODE=off
			fi
			;;
		*) die "GALVANI_WORKER_MODE must be on, off or auto (got '$GALVANI_WORKER_MODE')." ;;
	esac

	GALVANI_HOT_RELOAD="${GALVANI_HOT_RELOAD:-off}"
	case "$GALVANI_HOT_RELOAD" in
		on | off) ;;
		auto)
			if [ "$is_prod" = 0 ] && fs_has_events /app; then
				GALVANI_HOT_RELOAD=on
			else
				GALVANI_HOT_RELOAD=off
			fi
			;;
		*) die "GALVANI_HOT_RELOAD must be on, off or auto (got '$GALVANI_HOT_RELOAD')." ;;
	esac
	if [ "$is_prod" = 1 ] && [ "$GALVANI_HOT_RELOAD" = on ]; then
		die "GALVANI_HOT_RELOAD must not be enabled when APP_ENV=prod."
	fi

	export GALVANI_WORKER_MODE GALVANI_HOT_RELOAD
}

check_secrets() {
	[ "${APP_ENV:-prod}" = "prod" ] || return 0

	case "${APP_DEBUG:-0}" in
		1 | true | on | yes) die "APP_DEBUG must not be enabled when APP_ENV=prod." ;;
	esac

	for name in ${GALVANI_REQUIRED_SECRETS:-}; do
		case "$name" in
			'' | *[!A-Za-z0-9_]*) die "Invalid variable name in GALVANI_REQUIRED_SECRETS: '$name'" ;;
		esac
		eval "value=\${$name:-}"
		# shellcheck disable=SC2154
		if [ -z "$value" ]; then
			die "$name is not set. Generate one with: openssl rand -hex 32"
		fi
		if [ "${#value}" -lt 32 ]; then
			die "$name is too short (${#value} chars, minimum 32). Generate one with: openssl rand -hex 32"
		fi
		case "$value" in
			*ChangeMe* | *changeme* | *CHANGEME* | *ChangeThis* | *dev-only* | *insecure*)
				die "$name still contains a placeholder value." ;;
		esac
	done
}

composer_install() {
	[ "${GALVANI_COMPOSER_INSTALL:-0}" = "1" ] || return 0
	[ -f composer.json ] || return 0
	[ -f vendor/autoload_runtime.php ] && return 0
	command -v composer >/dev/null 2>&1 || die "vendor/ is missing and Composer is not available in this image."
	log "vendor/ missing -> composer install"
	composer install --prefer-dist --no-progress --no-interaction
}

wait_for_database_and_migrate() {
	[ "${GALVANI_MIGRATE:-0}" = "1" ] || return 0
	[ -f bin/console ] || return 0
	[ -n "${DATABASE_URL:-}" ] || return 0
	php bin/console list doctrine --raw 2>/dev/null | grep -q '^doctrine:migrations:migrate' || {
		log "GALVANI_MIGRATE=1 but doctrine/migrations is not installed - skipping."
		return 0
	}

	log "Waiting for the database..."
	attempts=${GALVANI_DB_WAIT_SECONDS:-60}
	until php bin/console dbal:run-sql -q "SELECT 1" >/dev/null 2>&1; do
		attempts=$((attempts - 1))
		[ "$attempts" -gt 0 ] || die "Database not reachable. Check DATABASE_URL and the database service."
		sleep 1
	done

	if [ -n "$(find ./migrations -iname '*.php' -print -quit 2>/dev/null)" ]; then
		log "Running Doctrine migrations"
		php bin/console doctrine:migrations:migrate --no-interaction --all-or-nothing --allow-no-migration
	fi
}

if is_app_command "$1"; then
	resolve_modes
	check_secrets
	if [ "$1" = frankenphp ] && [ "${2:-}" = run ]; then
		log "worker mode: $GALVANI_WORKER_MODE, hot reload: $GALVANI_HOT_RELOAD (/app filesystem: $(fs_type /app))"
	fi
	if [ -f /app/composer.json ]; then
		cd /app
		composer_install
		wait_for_database_and_migrate
	fi
fi

exec docker-php-entrypoint "$@"
