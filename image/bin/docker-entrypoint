#!/bin/sh
# Galvani entrypoint.
#
# Responsibilities (all opt-in via env, all no-ops for non-app commands):
#   1. Refuse to start in prod with missing/weak/placeholder secrets  (GALVANI_REQUIRED_SECRETS)
#   2. Install vendors on first dev start                             (GALVANI_COMPOSER_INSTALL=1)
#   3. Wait for the database and run Doctrine migrations              (GALVANI_MIGRATE=1)
set -eu

log() { printf '[galvani] %s\n' "$*" >&2; }
die() { log "FATAL: $*"; exit 1; }

# `docker run image --some-flag` -> pass flags to frankenphp
if [ "${1#-}" != "$1" ]; then
	set -- frankenphp run "$@"
fi

is_app_command() {
	case "$1" in
		frankenphp | php | bin/console | galvani-worker) return 0 ;;
		*) return 1 ;;
	esac
}

check_secrets() {
	[ "${APP_ENV:-prod}" = "prod" ] || return 0

	case "${APP_DEBUG:-0}" in
		1 | true | on | yes) die "APP_DEBUG must not be enabled when APP_ENV=prod." ;;
	esac

	for name in ${GALVANI_REQUIRED_SECRETS:-}; do
		case "$name" in
			'' | *[!A-Za-z0-9_]*) die "Invalid variable name in GALVANI_REQUIRED_SECRETS: '$name'" ;;
		esac
		eval "value=\${$name:-}"
		# shellcheck disable=SC2154
		if [ -z "$value" ]; then
			die "$name is not set. Generate one with: openssl rand -hex 32"
		fi
		if [ "${#value}" -lt 32 ]; then
			die "$name is too short (${#value} chars, minimum 32). Generate one with: openssl rand -hex 32"
		fi
		case "$value" in
			*ChangeMe* | *changeme* | *CHANGEME* | *ChangeThis* | *dev-only* | *insecure*)
				die "$name still contains a placeholder value." ;;
		esac
	done
}

composer_install() {
	[ "${GALVANI_COMPOSER_INSTALL:-0}" = "1" ] || return 0
	[ -f composer.json ] || return 0
	[ -f vendor/autoload_runtime.php ] && return 0
	command -v composer >/dev/null 2>&1 || die "vendor/ is missing and Composer is not available in this image."
	log "vendor/ missing -> composer install"
	composer install --prefer-dist --no-progress --no-interaction
}

wait_for_database_and_migrate() {
	[ "${GALVANI_MIGRATE:-0}" = "1" ] || return 0
	[ -f bin/console ] || return 0
	[ -n "${DATABASE_URL:-}" ] || return 0
	php bin/console list doctrine --raw 2>/dev/null | grep -q '^doctrine:migrations:migrate' || {
		log "GALVANI_MIGRATE=1 but doctrine/migrations is not installed - skipping."
		return 0
	}

	log "Waiting for the database..."
	attempts=${GALVANI_DB_WAIT_SECONDS:-60}
	until php bin/console dbal:run-sql -q "SELECT 1" >/dev/null 2>&1; do
		attempts=$((attempts - 1))
		[ "$attempts" -gt 0 ] || die "Database not reachable. Check DATABASE_URL and the database service."
		sleep 1
	done

	if [ -n "$(find ./migrations -iname '*.php' -print -quit 2>/dev/null)" ]; then
		log "Running Doctrine migrations"
		php bin/console doctrine:migrations:migrate --no-interaction --all-or-nothing --allow-no-migration
	fi
}

if is_app_command "$1"; then
	check_secrets
	if [ -f /app/composer.json ]; then
		cd /app
		composer_install
		wait_for_database_and_migrate
	fi
fi

exec docker-php-entrypoint "$@"
