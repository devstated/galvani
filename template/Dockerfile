# syntax=docker/dockerfile:1
#
# Application image, built on the Galvani base image.
# Generated by galvani/bin/galvani-init — safe to edit for app-specific needs
# (extra PHP extensions, asset build steps, ...).
#
# Targets:
#   dev   -> local development (code is bind-mounted, see compose.override.yaml)
#   prod  -> production image (code baked in, owned by root, runs as www-data)

ARG GALVANI_IMAGE=ghcr.io/devstated/galvani-php
ARG GALVANI_TAG=1

# ---------------------------------------------------------------------------
FROM ${GALVANI_IMAGE}:${GALVANI_TAG}-dev AS dev
# Add dev-only extensions here, e.g.:
# RUN install-php-extensions gd

# ---------------------------------------------------------------------------
FROM ${GALVANI_IMAGE}:${GALVANI_TAG}-dev AS build

ENV APP_ENV=prod APP_DEBUG=0

# Vendors first, for layer caching
COPY --link composer.json composer.lock ./
RUN --mount=type=cache,target=/composer-cache \
	composer install --no-dev --prefer-dist --no-autoloader --no-scripts --no-progress --no-interaction

COPY --link . ./

RUN --mount=type=cache,target=/composer-cache <<-EOF
	set -eu
	rm -rf var/ .env.local .env.*.local
	composer dump-autoload --classmap-authoritative --no-dev
	composer run-script --no-dev post-install-cmd
	if php bin/console list --raw | grep -q '^importmap:install'; then php bin/console importmap:install; fi
	if php bin/console list --raw | grep -q '^asset-map:compile'; then php bin/console asset-map:compile; fi
	rm -rf var/
EOF

# ---------------------------------------------------------------------------
FROM ${GALVANI_IMAGE}:${GALVANI_TAG} AS prod

# Add runtime extensions here (needs root for the install, then back to www-data):
# USER root
# RUN install-php-extensions gd
# USER 33

# Code is owned by root: the PHP process (www-data) can read but never modify it.
COPY --link --from=build --chown=0:0 /app /app

# Warm the cache as www-data so var/ is writable at runtime.
RUN php bin/console cache:warmup --no-interaction
