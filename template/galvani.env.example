# Galvani — production environment variables.
#
# Set these in Coolify → the app resource → "Environment Variables".
# Do NOT commit real values. Do NOT tick "Build Variable" for secrets: they are only
# needed at runtime and must never end up in an image layer.
#
# Generate every secret with:   openssl rand -hex 32
# (hex keeps them URL-safe: they are embedded in DATABASE_URL, REDIS_URL, AMQP DSN)

# --- required -------------------------------------------------------------------
APP_DOMAIN=app.example.com
APP_SECRET=
MERCURE_JWT_SECRET=
POSTGRES_PASSWORD=
VALKEY_PASSWORD=
RABBITMQ_PASSWORD=
# e.g. smtp://user:pass@smtp.example.com:587  or a provider DSN (ses+api://..., brevo+api://...)
MAILER_DSN=

# --- optional (defaults shown) ----------------------------------------------------
# POSTGRES_DB=app
# POSTGRES_USER=app
# RABBITMQ_USER=app
# GALVANI_MIGRATE=1                       # run Doctrine migrations on php start
# MESSENGER_TRANSPORTS=async              # e.g. "async scheduler_default"
# MESSENGER_TIME_LIMIT=3600
# MESSENGER_MEMORY_LIMIT=256M
# FRANKENPHP_WORKER_CONFIG=               # e.g. "num 8"  (default: 2 x CPU cores)
# MERCURE_EXTRA_DIRECTIVES=               # e.g. "anonymous" or "cors_origins https://other.example.com"
# TRUSTED_PROXIES=private_ranges

# --- sizing (defaults fit a 2 vCPU / 4 GB VPS) --------------------------------------
# PHP_MEM_LIMIT=1536M
# WORKER_MEM_LIMIT=512M
# POSTGRES_MEM_LIMIT=1G
# POSTGRES_SHARED_BUFFERS=256MB           # ~25% of the DB's memory
# POSTGRES_EFFECTIVE_CACHE_SIZE=768MB     # ~75% of the DB's memory
# POSTGRES_WORK_MEM=8MB
# POSTGRES_MAINTENANCE_WORK_MEM=64MB
# POSTGRES_MAX_CONNECTIONS=100
# VALKEY_MEM_LIMIT=384M
# VALKEY_MAXMEMORY=256mb                  # keep ~30% below VALKEY_MEM_LIMIT
# VALKEY_MAXMEMORY_POLICY=allkeys-lru     # use volatile-lru when sessions/locks are stored too
# VALKEY_IO_THREADS=1                     # raise to 4-8 on big machines
# RABBITMQ_MEM_LIMIT=512M
